# Google OAuth credentials for LOCAL Supabase auth.
# Copy to `.env.google.local` (gitignored) and fill in from the Google Cloud
# Console (see README "Google sign-in (local)"). These are read by the Supabase
# CLI via env() substitution in supabase/config.toml when you start the stack
# with `npm run db:start` (which sources this file).
#
# NEVER commit the real values.

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret
