# Copy to .env.local and fill in. Never commit .env.local.
#
# From your Supabase project settings (or `supabase start` for local dev).
# Only the anon key lives in the app — there is NO service-role key in v1
# (the anon client + RLS is the entire authz story; see ENGINEERING_PLAN.md decision 7).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the app is served (used for the OAuth redirect callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
