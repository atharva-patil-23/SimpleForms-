# Copy to .env.local and fill in. Never commit .env.local.
#
# From your Supabase project settings (or `supabase start` for local dev).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the app is served (used for the OAuth redirect callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role (a.k.a. "secret") key — SERVER ONLY, never exposed to the client
# (no NEXT_PUBLIC_ prefix). Used for exactly one elevated operation: letting a
# signed-in user delete their own auth account (Settings → Delete account).
# Local: the "Secret" key printed by `supabase start`. Prod: Supabase →
# Project Settings → API → service_role / secret key. Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
